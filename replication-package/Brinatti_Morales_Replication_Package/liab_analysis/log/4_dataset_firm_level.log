  3. 
. bysort jahr ao_kreis: egen kreis_`x'_`y'=sum(tot_earn1*`x'*`y')
  4. bysort jahr local_labor11: egen loclabor_`x'_`y'=sum(tot_earn1*`x'*`y')
  5. bysort jahr: egen year_`x'_`y'=sum(tot_earn1*`x'*`y')
  6. 
. bysort jahr ao_kreis: egen nkreis_`x'_`y'=sum(main_obs*`x'*`y')
  7. bysort jahr local_labor11: egen nloclabor_`x'_`y'=sum(main_obs*`x'*`y')
  8. bysort jahr: egen nyear_`x'_`y'=sum(main_obs*`x'*`y')
  9. 
. 
. }
 10. }

